            "delete": {
                "tags": [
                    "Comptes"
                ],
                "summary": "Supprime un compte",
                "description": "Supprime un compte existant (soft delete)",
                "operationId": "bfb2ad061854b9b93873c60a24618ff9",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID du compte",
